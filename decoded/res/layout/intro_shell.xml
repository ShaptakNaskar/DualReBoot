<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout style="@style/DualBoot.Style.Layout.Vertical"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:id="@id/intro_footer" android:layout_marginLeft="@dimen/spacing.small" android:layout_marginRight="@dimen/spacing.small" android:layout_alignParentLeft="true" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" style="@style/DualBoot.Style.Layout.Horizontal">
        <Button android:text="@string/Intro_Settings" android:layout_weight="1.0" android:onClick="onOpenSettings" style="@style/DualBoot.Style.Button" />
        <Button android:text="@string/Intro_Continue" android:layout_weight="1.0" android:onClick="onChooseWallpaper" style="@style/DualBoot.Style.Button" />
    </LinearLayout>
    <ScrollView android:id="@id/sv_intro_scroll" android:layout_above="@id/intro_footer" android:layout_alignParentTop="true" android:layout_centerHorizontal="true" style="@style/DualBoot.Style.Layout.ScrollView">
        <LinearLayout android:id="@id/intro_main" android:layout_marginLeft="@dimen/spacing.small" android:layout_marginRight="@dimen/spacing.small" style="@style/DualBoot.Style.Layout.Vertical">
            <com.dualboot.widget.TextViewHeaderImg android:text="@string/app_name" app:img_bitmap_src="@drawable/thumb" app:img_bitmap_src_override="@drawable/thumb_header" style="@style/DualBoot.Style.Text.Header.Img" />
            <TextView android:textSize="16.0sp" android:id="@id/intro_summary_text" android:text="@string/Intro_Summary" style="@style/DualBoot.Style.Text.Primary" />
            <View android:layout_margin="@dimen/spacing" style="@style/DualBoot.Style.Divider" />
            <include layout="@layout/intro_content" />
            <View android:layout_margin="@dimen/spacing" style="@style/DualBoot.Style.Divider" />
            <RelativeLayout style="@style/DualBoot.Style">
                <FrameLayout android:id="@id/shared_moreapps" android:layout_marginTop="@dimen/spacing" style="@style/DualBoot.Style">
                    <include layout="@layout/shared_moreapps" />
                </FrameLayout>
                <ImageView android:id="@id/intro_logo_img" android:layout_marginTop="@dimen/spacing" android:src="@drawable/logo" android:layout_below="@id/shared_moreapps" android:layout_alignLeft="@id/shared_moreapps" android:layout_alignRight="@id/shared_moreapps" android:layout_centerHorizontal="true" android:alpha="0.75" style="@style/DualBoot.Style" />
                <TextView android:textSize="12.0sp" android:gravity="center|top" android:id="@id/intro_copyright_text" android:text="@string/Copyright" android:layout_below="@id/intro_logo_img" android:layout_alignLeft="@id/intro_logo_img" android:layout_alignRight="@id/intro_logo_img" android:layout_centerHorizontal="true" android:alpha="0.5" style="@style/DualBoot.Style.Text.Small" />
                <TextView android:textSize="12.0sp" android:gravity="center|top" android:id="@id/intro_version" android:padding="0.0dp" android:visibility="gone" android:text="@string/Intro_Version" android:layout_below="@id/intro_copyright_text" android:layout_alignLeft="@id/intro_copyright_text" android:layout_alignRight="@id/intro_copyright_text" android:layout_centerHorizontal="true" android:alpha="0.5" style="@style/DualBoot.Style.Text.Small" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
